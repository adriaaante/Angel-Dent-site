# Angel-Dent — канонизация хоста, кэш/сжатие, 301-редиректы со старых (Tilda)
# URL и брендовый 404. Лежит в корне публичной папки (деплоится из репозитория).

# Кодировка в HTTP-заголовке Content-Type. Без неё Apache отдаёт просто
# "text/html", и разбор кодировки остаётся на откуп <meta charset> —
# браузеры справляются, но часть парсеров (агрегаторы, SEO-сервисы,
# скрипты) читают кириллицу как латиницу. У Венеции строка была с самого
# начала, здесь выравниваем.
AddDefaultCharset UTF-8

# --- Канонический хост: только https и без www (единый 301) ---
# Убирает дубли http/https и www/non-www (важно для Яндекса и склейки веса).
# Проверка X-Forwarded-Proto — чтобы не зациклиться за SSL-прокси reg.ru.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # www.angel-denta.ru → angel-denta.ru (сразу на https)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
    # http → https
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Сжатие (gzip) ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/xml application/xml \
        application/javascript application/json image/svg+xml
</IfModule>

# --- Кэширование статики (ускоряет повторные заходы, помогает Core Web Vitals) ---
# Без хэшей в именах файлов, поэтому css/js кэшируем умеренно (7 дней),
# изображения — 30 дней, html — 1 час.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 7 days"
    ExpiresByType application/javascript  "access plus 7 days"
    ExpiresByType image/webp              "access plus 30 days"
    ExpiresByType image/png               "access plus 30 days"
    ExpiresByType image/jpeg              "access plus 30 days"
    ExpiresByType image/x-icon            "access plus 30 days"
    ExpiresByType image/svg+xml           "access plus 30 days"
    ExpiresByType text/html               "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
    Header append Vary: Accept-Encoding
</IfModule>

# 301-редиректы со старых (Tilda) URL. Порядок важен: частные правила выше общих.
<IfModule mod_alias.c>
    # --- точечные старые страницы ---
    RedirectMatch 301 ^/breket/?$    /services/ortodontiya.html
    RedirectMatch 301 ^/ortodont/?$  /services/ortodontiya.html
    RedirectMatch 301 ^/hiryrgia/?$  /services/hirurgiya.html
    RedirectMatch 301 ^/hiryrg/?$    /services/hirurgiya.html
    RedirectMatch 301 ^/therapy/?$   /services/terapiya.html
    RedirectMatch 301 ^/price/?$     /services/
    RedirectMatch 301 ^/about/?$     /about.html
    RedirectMatch 301 ^/ovsepyan/?$  /doctors/
    # врач больше не работает в клинике (снята 10.08.2026)
    RedirectMatch 301 ^/doctors/smolyakova\.html$ /doctors/

    # --- старый раздел /uslugi/* → профильные услуги (частное выше общего) ---
    RedirectMatch 301 ^/uslugi/implantaciya(/.*)?$            /services/implantaciya.html
    RedirectMatch 301 ^/uslugi/ortodontiya(/.*)?$            /services/ortodontiya.html
    RedirectMatch 301 ^/uslugi/ortopediya(/.*)?$             /services/protezirovanie.html
    RedirectMatch 301 ^/uslugi/protezirovanie(/.*)?$         /services/protezirovanie.html
    RedirectMatch 301 ^/uslugi/parodontologiya(/.*)?$        /services/parodontologiya.html
    RedirectMatch 301 ^/uslugi/terapiya(/.*)?$               /services/terapiya.html
    RedirectMatch 301 ^/uslugi/detskaya-stomatologiya(/.*)?$ /services/detskaya.html
    RedirectMatch 301 ^/uslugi/hirurgiya(/.*)?$              /services/hirurgiya.html
    RedirectMatch 301 ^/uslugi/gigiena(/.*)?$                /services/gigiena.html
    RedirectMatch 301 ^/uslugi/viniry(/.*)?$                 /services/viniry.html
    # общий «хвост» для остальных старых /uslugi/* → витрина услуг
    RedirectMatch 301 ^/uslugi(/.*)?$                        /services/

    # --- прочие корневые слаги старой Tilda (префиксы /health_*, /child_*) ---
    # частные выше общих
    RedirectMatch 301 ^/health_breket/?$                     /services/ortodontiya.html
    RedirectMatch 301 ^/child_orto/?$                        /services/ortodontiya.html
    RedirectMatch 301 ^/health_.*$                           /services/
    RedirectMatch 301 ^/child_.*$                            /services/detskaya.html

    # --- старый блог Tilda (/tpost/*) → новый блог ---
    RedirectMatch 301 ^/tpost(/.*)?$                         /blog/
</IfModule>

# Брендовая страница 404 вместо дефолтной reg.ru.
ErrorDocument 404 /404.html
